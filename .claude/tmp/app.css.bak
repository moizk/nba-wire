/* ===========================================================================
   NBA WIRE — "stormtrooper" shell
   White moulded ABS plates, black visor, hairline seams. Light-mode only and
   deliberately so: the whole identity is the white armour.
   =========================================================================== */

:root {
  --shell:    #e7e9ec;
  --shell-d:  #d8dbe0;
  --panel:    #ffffff;
  --panel-2:  #f6f7f9;
  --panel-3:  #eef0f3;

  --ink:      #0b0c0e;
  --ink-2:    #3d434b;
  --ink-3:    #797f89;
  --ink-4:    #a7adb6;

  --line:     rgba(11,12,14,.085);
  --line-2:   rgba(11,12,14,.16);
  --seam:     rgba(11,12,14,.28);

  --visor:    #0b0c0e;
  --live:     #17b978;
  --warn:     #e2a03f;
  --dead:     #d9503f;

  --gloss: linear-gradient(180deg,#fff 0%,#fafbfc 46%,#eef0f3 46%,#f7f8fa 100%);
  --plate: 0 1px 0 rgba(255,255,255,.95) inset,
           0 -1px 0 rgba(11,12,14,.05) inset,
           0 1px 2px rgba(11,12,14,.055),
           0 8px 20px -12px rgba(11,12,14,.18);

  --r:   12px;
  --r-s: 8px;
  --hair: 1px solid var(--line);

  --font: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica,
          "Segoe UI", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
}

* { box-sizing: border-box; }

html, body {
  height: 100%;
  margin: 0;
  overflow: hidden;               /* full-screen console: panes scroll, page never does */
  overscroll-behavior: none;
}

body {
  font-family: var(--font);
  font-size: 14px;
  line-height: 1.45;
  color: var(--ink);
  background: var(--shell);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

::selection { background: var(--ink); color: #fff; }

/* Scrollbars styled as thin armour seams rather than OS chrome. */
.scroll { overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--ink-4) transparent; }
.scroll::-webkit-scrollbar { width: 10px; }
.scroll::-webkit-scrollbar-track { background: transparent; }
.scroll::-webkit-scrollbar-thumb {
  background: rgba(11,12,14,.22);
  border: 3px solid transparent;
  border-radius: 99px;
  background-clip: content-box;
}
.scroll::-webkit-scrollbar-thumb:hover { background: rgba(11,12,14,.4); background-clip: content-box; }

/* ---------------------------------------------------------------------------
   Shell grid
   --------------------------------------------------------------------------- */

.shell {
  display: grid;
  grid-template-rows: 54px minmax(0,1fr) 30px;
  height: 100dvh;
  gap: 8px;
  padding: 8px;
}

.body {
  display: grid;
  grid-template-columns: 228px minmax(0,1fr) 330px;
  gap: 8px;
  min-height: 0;
}

.plate {
  background: var(--panel);
  border-radius: var(--r);
  box-shadow: var(--plate);
  min-height: 0;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ---------------------------------------------------------------------------
   Visor — the black eye band
   --------------------------------------------------------------------------- */

.visor {
  background: var(--visor);
  border-radius: var(--r);
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 14px;
  color: #fff;
  box-shadow: 0 1px 0 rgba(255,255,255,.14) inset,
              0 10px 24px -14px rgba(11,12,14,.7);
  position: relative;
  overflow: hidden;
}
/* Faint specular sweep across the visor, like moulded gloss. */
.visor::after {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(104deg, rgba(255,255,255,.11) 0 22%, transparent 42%);
  pointer-events: none;
}

.mark { display: flex; align-items: baseline; gap: 7px; user-select: none; flex: none; }
.mark b {
  font-size: 15px; font-weight: 800; letter-spacing: -.02em;
  background: #fff; color: var(--visor);
  padding: 3px 7px; border-radius: 5px; line-height: 1;
}
.mark span {
  font-size: 12.5px; font-weight: 600; letter-spacing: .30em;
  color: rgba(255,255,255,.94); text-transform: uppercase;
}

.pulse {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--live); flex: none;
  box-shadow: 0 0 0 0 rgba(23,185,120,.65);
  animation: pulse 2.6s ease-out infinite;
}
@keyframes pulse {
  0%   { box-shadow: 0 0 0 0 rgba(23,185,120,.6); }
  70%  { box-shadow: 0 0 0 7px rgba(23,185,120,0); }
  100% { box-shadow: 0 0 0 0 rgba(23,185,120,0); }
}

/* Search: a white pill inset into the black band. */
.search { flex: 1; display: flex; align-items: center; gap: 8px; max-width: 460px; position: relative; }
.search svg { position: absolute; left: 11px; width: 14px; height: 14px; opacity: .42; pointer-events: none; }
#q {
  width: 100%;
  font: inherit; font-size: 13px;
  color: var(--ink);
  background: #fff;
  border: 0; border-radius: 99px;
  padding: 8px 74px 8px 32px;
  outline: none;
  box-shadow: 0 1px 0 rgba(255,255,255,.6), 0 2px 6px rgba(0,0,0,.28) inset;
}
#q::placeholder { color: var(--ink-4); }
#q:focus { box-shadow: 0 0 0 2.5px rgba(255,255,255,.55), 0 2px 6px rgba(0,0,0,.2) inset; }
.slash {
  position: absolute; right: 9px; top: 50%; transform: translateY(-50%);
  font: 10px/1 var(--mono); color: var(--ink-4);
  border: 1px solid var(--line-2); border-radius: 4px;
  padding: 3px 5px; pointer-events: none; background: var(--panel-2);
}
.search.on .slash { display: none; }

.visor-meta {
  margin-left: auto; display: flex; align-items: center; gap: 16px;
  font: 10.5px/1 var(--mono); color: rgba(255,255,255,.62);
  letter-spacing: .06em; flex: none;
}
.visor-meta b { color: #fff; font-weight: 600; }
.visor-meta .sep { width: 1px; height: 16px; background: rgba(255,255,255,.16); }

/* ---------------------------------------------------------------------------
   Panel furniture
   --------------------------------------------------------------------------- */

.cap {
  flex: none;
  display: flex; align-items: center; gap: 8px;
  padding: 0 12px; height: 34px;
  font-size: 9.5px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase;
  color: var(--ink-3);
  background: var(--gloss);
  border-bottom: var(--hair);
  border-radius: var(--r) var(--r) 0 0;
}
.cap .n {
  margin-left: auto;
  font: 10px/1 var(--mono); letter-spacing: 0;
  color: var(--ink-3);
  background: var(--panel-3);
  border: var(--hair); border-radius: 99px;
  padding: 3px 7px;
}

/* ---------------------------------------------------------------------------
   Rail — iPod menu behaviour: selection is a solid black bar
   --------------------------------------------------------------------------- */

.rail { padding: 6px; }
.rail-group + .rail-group { margin-top: 4px; border-top: var(--hair); padding-top: 6px; }
.rail-h {
  padding: 7px 8px 5px;
  font-size: 9px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
  color: var(--ink-4);
}

.opt {
  display: flex; align-items: center; gap: 8px;
  width: 100%; text-align: left;
  padding: 7px 9px; margin: 1px 0;
  border: 0; border-radius: var(--r-s);
  background: transparent;
  font: inherit; font-size: 13px; color: var(--ink-2);
  cursor: pointer;
  transition: background .1s ease, color .1s ease;
}
.opt:hover { background: var(--panel-3); color: var(--ink); }
.opt .k {
  font: 9.5px/1 var(--mono); color: var(--ink-4);
  border: 1px solid var(--line); border-radius: 3px;
  padding: 2px 4px; flex: none;
}
.opt .c { margin-left: auto; font: 10px/1 var(--mono); color: var(--ink-4); flex: none; }
.opt .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-4); flex: none; }
.opt .dot.live { background: var(--live); }
.opt .dot.dead { background: var(--dead); }
.opt .lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.opt[aria-pressed="true"] {
  background: var(--ink); color: #fff;
  box-shadow: 0 1px 0 rgba(255,255,255,.16) inset, 0 1px 3px rgba(11,12,14,.3);
}
.opt[aria-pressed="true"] .c,
.opt[aria-pressed="true"] .k { color: rgba(255,255,255,.62); border-color: rgba(255,255,255,.22); }

/* ---------------------------------------------------------------------------
   Wire list
   --------------------------------------------------------------------------- */

.wire { padding: 0; }
.list { padding: 4px 0 14px; }

.row {
  display: grid;
  grid-template-columns: 52px 1fr;
  gap: 10px;
  padding: 9px 14px;
  border-bottom: var(--hair);
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  /* Long lists stay cheap: the browser skips layout for off-screen rows. */
  content-visibility: auto;
  contain-intrinsic-size: auto 62px;
  scroll-margin: 60px;
}
.row:hover { background: var(--panel-2); }
.row.hide { display: none; }

.row .when {
  font: 10px/1.5 var(--mono);
  color: var(--ink-4);
  text-align: right;
  padding-top: 2px;
  white-space: nowrap;
}
.row .when i { display: block; font-style: normal; color: var(--ink-3); font-weight: 600; }

.row h3 {
  margin: 0 0 3px;
  font-size: 14px; font-weight: 590; letter-spacing: -.011em; line-height: 1.32;
  color: var(--ink);
}
.row p {
  margin: 0 0 5px;
  font-size: 12.5px; line-height: 1.42; color: var(--ink-3);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}
.meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

.chip {
  font: 9.5px/1 var(--mono); letter-spacing: .04em;
  text-transform: uppercase; font-weight: 600;
  padding: 3.5px 6px; border-radius: 4px;
  border: var(--hair); background: var(--panel-2); color: var(--ink-2);
  flex: none;
}
.chip.src   { background: var(--ink); color: #fff; border-color: var(--ink); }
.chip.rumor { background: #fff5e6; border-color: #f0d6a8; color: #8a5d10; }
.chip.social{ background: #eef1ff; border-color: #ccd4f7; color: #3a49a8; }
.chip.team  { background: #fff; }
.chip.x     { background: var(--ink); color: #fff; border-color: var(--ink); }

.row.sel { background: var(--ink); }
.row.sel h3 { color: #fff; }
.row.sel p  { color: rgba(255,255,255,.66); }
.row.sel .when, .row.sel .when i { color: rgba(255,255,255,.55); }
.row.sel .chip { background: rgba(255,255,255,.13); border-color: rgba(255,255,255,.2); color: #fff; }
.row.sel .chip.src, .row.sel .chip.x { background: #fff; color: var(--ink); border-color: #fff; }

/* Lead story sits above the list with artwork. */
.lead {
  display: grid; grid-template-columns: 148px 1fr; gap: 14px;
  padding: 14px; margin: 0;
  border-bottom: 1px solid var(--line-2);
  text-decoration: none; color: inherit;
  background: linear-gradient(180deg,#fff,#fbfcfd);
}
.lead:hover { background: var(--panel-2); }
.lead.hide { display: none; }
/* No artwork in the feed: drop the image column instead of squeezing the text. */
.lead.noart { grid-template-columns: 1fr; }
.lead.sel { background: var(--ink); }
.lead.sel h2 { color: #fff; }
.lead.sel p { color: rgba(255,255,255,.66); }
.lead.sel .chip { background: rgba(255,255,255,.13); border-color: rgba(255,255,255,.2); color: #fff; }
.lead.sel .chip.src, .lead.sel .chip.x { background: #fff; color: var(--ink); border-color: #fff; }
.lead .art {
  aspect-ratio: 16/10; border-radius: var(--r-s);
  overflow: hidden; background: var(--panel-3);
  border: var(--hair);
}
.lead .art img { width: 100%; height: 100%; object-fit: cover; display: block; }
.lead h2 {
  margin: 4px 0 5px;
  font-size: 19px; font-weight: 700; letter-spacing: -.021em; line-height: 1.2;
}
.lead p { margin: 0 0 8px; font-size: 13px; color: var(--ink-3); line-height: 1.45;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

.empty { padding: 44px 20px; text-align: center; color: var(--ink-4); font-size: 13px; }
.empty b { display: block; color: var(--ink-2); font-size: 14px; margin-bottom: 4px; }

/* ---------------------------------------------------------------------------
   Right column
   --------------------------------------------------------------------------- */

.side { display: grid; grid-template-rows: minmax(0,1.35fr) minmax(0,1fr); gap: 8px; min-height: 0; }

.trend { padding: 6px 8px 10px; }
.tr {
  display: block; text-decoration: none; color: inherit;
  padding: 9px 8px; border-radius: var(--r-s);
  border-bottom: var(--hair);
}
.tr:last-child { border-bottom: 0; }
.tr:hover { background: var(--panel-2); }
.tr .top { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
.tr .rank {
  font: 10px/1 var(--mono); font-weight: 700;
  width: 17px; height: 17px; border-radius: 4px;
  display: grid; place-items: center; flex: none;
  background: var(--ink); color: #fff;
}
.tr h4 { margin: 0; font-size: 12.8px; font-weight: 590; line-height: 1.34; letter-spacing: -.008em; }
.tr .via { margin-top: 4px; font: 9.5px/1 var(--mono); color: var(--ink-4); letter-spacing: .03em; }

.health { padding: 6px; }
.hrow {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px; border-radius: 6px;
  font-size: 12px; color: var(--ink-2);
}
.hrow:hover { background: var(--panel-2); }
.hrow .dot { width: 6px; height: 6px; border-radius: 50%; flex: none; background: var(--live); }
.hrow .dot.dead { background: var(--dead); }
.hrow .dot.warn { background: var(--warn); }
.hrow .ms { margin-left: auto; font: 10px/1 var(--mono); color: var(--ink-4); }

/* ---------------------------------------------------------------------------
   Status strip
   --------------------------------------------------------------------------- */

.strip {
  display: flex; align-items: center; gap: 14px;
  padding: 0 12px;
  background: var(--gloss);
  border-radius: var(--r);
  box-shadow: var(--plate);
  font: 10.5px/1 var(--mono);
  color: var(--ink-3);
  letter-spacing: .04em;
  overflow: hidden;
}
.strip kbd {
  font: 10px/1 var(--mono); color: var(--ink-2);
  background: #fff; border: 1px solid var(--line-2);
  border-bottom-width: 2px; border-radius: 4px;
  padding: 3px 5px; margin-right: 4px;
}
.strip .grow { margin-left: auto; }
.hint { flex: none; }
/* Shown only in the narrow layout; the media query flips these two. */
.strip .hint.mobile { display: none; }

/* New-stories pill, floats over the wire. */
.newpill {
  position: absolute; left: 50%; top: 44px; transform: translate(-50%, -14px);
  z-index: 6;
  display: flex; align-items: center; gap: 7px;
  padding: 7px 13px; border-radius: 99px;
  background: var(--ink); color: #fff;
  font-size: 12px; font-weight: 600;
  border: 0; cursor: pointer;
  box-shadow: 0 8px 22px -8px rgba(11,12,14,.6);
  opacity: 0; pointer-events: none;
  transition: opacity .16s ease, transform .16s ease;
}
.newpill.on { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }

/* ---------------------------------------------------------------------------
   Responsive — collapse the side columns before the wire itself
   --------------------------------------------------------------------------- */

@media (max-width: 1180px) {
  .body { grid-template-columns: 200px minmax(0,1fr); }
  .side { display: none; }
}
@media (max-width: 820px) {
  .body { grid-template-columns: minmax(0,1fr); }
  .rail-plate { display: none; }
  .visor-meta { display: none; }
  .lead { grid-template-columns: 1fr; }
  /* Keep the lead from swallowing the first screen on a phone. */
  .lead .art { aspect-ratio: 16/9; max-height: 30vh; }
  .lead h2 { font-size: 17px; }
  .lead p { -webkit-line-clamp: 2; }
  /* No keyboard on a phone: swap the shortcut hints for the wire summary. */
  .strip .hint { display: none; }
  .strip .grow { display: none; }
  .strip .hint.mobile { display: block; }
}

@media (prefers-reduced-motion: reduce) {
  * { animation-duration: .001ms !important; transition-duration: .001ms !important; }
}
